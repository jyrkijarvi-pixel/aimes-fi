/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# OSM street-map tiles need the origin in the Referer header.
# Keep the existing privacy policy on legacy pages and APIs.
/
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/index.html
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/time-jump/*
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/en/
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/en/index.html
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/en/time-jump/*
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin
/museum/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://ids.si.edu https://3d-api.si.edu; frame-src https://3d-api.si.edu; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
/en/museum/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://ids.si.edu https://3d-api.si.edu; frame-src https://3d-api.si.edu; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
